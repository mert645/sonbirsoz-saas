generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── MULTI-TENANCY ───

enum TenantPlan {
  STARTER      // 1 kullanıcı, 500 haber/ay, temel özellikler
  PROFESSIONAL // 5 kullanıcı, 2000 haber/ay, AI özellikleri
  ENTERPRISE   // Sınırsız, özel domain, API erişimi
}

enum TenantRole {
  OWNER   // Tam yetki + fatura
  ADMIN   // Tam yetki
  EDITOR  // İçerik yönetimi
  AUTHOR  // Sadece kendi içerikleri
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model Tenant {
  id           String     @id @default(cuid())
  name         String     // "Son Bir Söz Müzik"
  slug         String     @unique // "muzik"
  domain       String?    @unique // "muzik.sonbirsoz.com" veya custom domain
  logo         String?
  favicon      String?
  primaryColor String     @default("#4F46E5")
  plan         TenantPlan @default(STARTER)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // İlişkiler
  users              TenantUser[]
  categories         Category[]
  articles           Article[]
  authors            Author[]
  media              Media[]
  tags               Tag[]
  comments           Comment[]
  rssSources         RSSSource[]
  socialPosts        SocialPost[]
  aiJobs             AIGenerationJob[]
  mediaGenerations   MediaGeneration[]
  moderationLogs     ModerationLog[]
  pushSubscriptions  PushSubscription[]
  newsletterSubs     NewsletterSubscriber[]
  settings           TenantSettings?
  subscription       TenantSubscription?

  @@map("tenants")
}

model TenantUser {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole @default(EDITOR)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("tenant_users")
}

model TenantSettings {
  id                    String  @id @default(cuid())
  tenantId              String  @unique
  siteName              String?
  tagline               String?
  defaultSeoTitle       String?
  defaultSeoDescription String?
  googleAnalyticsId     String?
  socialLinks           Json?   // { twitter, instagram, facebook, youtube }
  
  // Özellik bayrakları (plana göre)
  aiGenerationEnabled   Boolean @default(false)
  aiModerationEnabled   Boolean @default(false)
  videoStudioEnabled    Boolean @default(false)
  newsletterEnabled     Boolean @default(true)
  pushEnabled           Boolean @default(true)
  customDomainEnabled   Boolean @default(false)
  apiAccessEnabled      Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model TenantSubscription {
  id                   String             @id @default(cuid())
  tenantId             String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?
  plan                 TenantPlan
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_subscriptions")
}

model UsageRecord {
  id        String   @id @default(cuid())
  tenantId  String
  metric    String   // "ARTICLES", "STORAGE_MB", "AI_TOKENS"
  value     Int
  period    DateTime // Ay başı (2026-08-01)
  createdAt DateTime @default(now())

  @@unique([tenantId, metric, period])
  @@map("usage_records")
}

// ─── ENUMS ───

enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum UserRole {
  SUPER_ADMIN // Platform yöneticisi (tüm tenant'lara erişim)
  ADMIN
  EDITOR
  AUTHOR
  SUBSCRIBER
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AIJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SocialPlatform {
  TWITTER
  INSTAGRAM
  FACEBOOK
  TELEGRAM
  YOUTUBE
}

enum SocialPostStatus {
  SCHEDULED
  POSTED
  FAILED
}

enum MediaGenPurpose {
  COVER
  SOCIAL_SQUARE
  SOCIAL_STORY
  THUMBNAIL
  VIDEO
}

enum ModerationDecision {
  APPROVED
  REJECTED
  REVIEW
}

// ─── AUTH & USERS ───

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String
  role          UserRole  @default(SUBSCRIBER)
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenants          TenantUser[]
  articles         Article[]
  comments         Comment[]
  sessions         Session[]
  accounts         Account[]
  editorialActions EditorialAction[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── CONTENT ───

model Category {
  id          String     @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  color       String     @default("#4F46E5")
  icon        String?
  parentId    String?
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")
  articles Article[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

model Author {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  slug       String
  bio        String?
  avatar     String?
  email      String?
  expertise  String[]
  socialLinks Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  articles Article[]

  @@unique([tenantId, slug])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("authors")
}

model Article {
  id             String        @id @default(cuid())
  tenantId       String
  title          String
  slug           String
  spot           String?
  content        String
  coverImage     String?
  coverImageAlt  String?
  categoryId     String
  authorId       String
  userId         String
  status         ArticleStatus @default(DRAFT)
  isFeatured     Boolean       @default(false)
  isBreaking     Boolean       @default(false)
  isAIGenerated  Boolean       @default(false)
  sourceUrl      String?
  publishedAt    DateTime?
  scheduledAt    DateTime?
  seoTitle       String?
  seoDescription String?
  readingTime    Int           @default(0)
  viewCount      Int           @default(0)
  shareCount     Int           @default(0)
  rejectionNote  String?
  audioUrl       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category         Category          @relation(fields: [categoryId], references: [id])
  author           Author            @relation(fields: [authorId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  tags             ArticleTag[]
  comments         Comment[]
  media            ArticleMedia[]
  socialPosts      SocialPost[]
  editorialActions EditorialAction[]
  aiJobs           AIGenerationJob[]
  mediaGenerations MediaGeneration[]
  moderationLogs   ModerationLog[]
  // embedding        ArticleEmbedding?  // pgvector gerektirir - sonra aktif edilecek

  @@unique([tenantId, slug])
  @@index([tenantId, status, publishedAt(sort: Desc)])
  @@index([tenantId, categoryId, status])
  @@index([tenantId, authorId, status])
  @@map("articles")
}

model Tag {
  id        String       @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  createdAt DateTime     @default(now())

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  articles ArticleTag[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("tags")
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tags")
}

model Media {
  id        String   @id @default(cuid())
  tenantId  String
  url       String
  filename  String
  alt       String?
  caption   String?
  width     Int?
  height    Int?
  size      Int?
  format    String?
  folder    String   @default("Genel")
  createdAt DateTime @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  articles ArticleMedia[]

  @@index([tenantId, folder])
  @@map("media")
}

model ArticleMedia {
  articleId String
  mediaId   String
  order     Int    @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([articleId, mediaId])
  @@map("article_media")
}

model Comment {
  id        String        @id @default(cuid())
  tenantId  String
  articleId String
  userId    String
  content   String
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  moderationLogs ModerationLog[]

  @@index([tenantId, articleId, status])
  @@map("comments")
}

// ─── AI GENERATION ───

model AIGenerationJob {
  id          String      @id @default(cuid())
  tenantId    String
  articleId   String?
  type        String      // "article", "rewrite", "seo", "summary"
  status      AIJobStatus @default(PENDING)
  input       Json        // source data, prompts, config
  output      Json?       // generated content
  model       String      @default("claude-sonnet")
  tokensUsed  Int?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("ai_generation_jobs")
}

// ─── SOCIAL MEDIA ───

model SocialPost {
  id          String           @id @default(cuid())
  tenantId    String
  articleId   String
  platform    SocialPlatform
  status      SocialPostStatus @default(SCHEDULED)
  content     String?
  mediaUrl    String?
  externalId  String?
  scheduledAt DateTime?
  postedAt    DateTime?
  error       String?
  metrics     Json?
  createdAt   DateTime         @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([tenantId, articleId, platform])
  @@index([tenantId, status, scheduledAt])
  @@map("social_posts")
}

// ─── MEDIA GENERATION ───

model MediaGeneration {
  id          String          @id @default(cuid())
  tenantId    String
  articleId   String?
  purpose     MediaGenPurpose
  status      AIJobStatus     @default(PENDING)
  prompt      String
  provider    String?
  resultUrl   String?
  width       Int?
  height      Int?
  error       String?
  createdAt   DateTime        @default(now())
  completedAt DateTime?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([tenantId, articleId, purpose])
  @@map("media_generations")
}

// ─── AI MODERATION ───

/**
 * AI ön-moderasyon denetim kaydı (AI Act / denetlenebilirlik uyumu).
 * Her otomatik içerik moderasyonu skorları ve kararıyla loglanır;
 * REVIEW kararları admin kuyruğunda insan onayı bekler.
 */
model ModerationLog {
  id          String             @id @default(cuid())
  tenantId    String
  articleId   String?
  commentId   String?
  contentType String             // "article" | "comment"
  source      String             // "ai-generate" | "import" | "rss" | "comment" | "manual"
  decision    ModerationDecision
  scores      Json               // kategori → 0.0-1.0 skorlar
  maxCategory String?            // en yüksek skorlu ihlal kategorisi
  maxScore    Float?
  reason      String?            // AI gerekçesi
  model       String?            // kullanılan model (denetim için)
  reviewedBy  String?            // insan kararını veren admin userId
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime           @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([tenantId, decision, createdAt(sort: Desc)])
  @@index([tenantId, articleId])
  @@map("moderation_logs")
}

