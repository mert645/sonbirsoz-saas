// ─── EDITORIAL WORKFLOW ───

model EditorialAction {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  action    String   // "submit_review", "approve", "reject", "publish", "archive", "edit"
  note      String?
  diff      Json?
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt(sort: Desc)])
  @@map("editorial_actions")
}

// ─── RSS FEEDS ───

model RSSSource {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  url         String
  category    String?
  isActive    Boolean  @default(true)
  lastFetched DateTime?
  fetchCount  Int      @default(0)
  errorCount  Int      @default(0)
  createdAt   DateTime @default(now())

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  RSSItem[]

  @@unique([tenantId, url])
  @@index([tenantId])
  @@map("rss_sources")
}

model RSSItem {
  id          String   @id @default(cuid())
  sourceId    String
  externalId  String
  title       String
  link        String
  description String?
  pubDate     DateTime?
  isProcessed Boolean  @default(false)
  createdAt   DateTime @default(now())

  source RSSSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, externalId])
  @@index([isProcessed, createdAt(sort: Desc)])
  @@map("rss_items")
}

// ─── SUBSCRIPTIONS & SETTINGS ───

model PushSubscription {
  id         String   @id @default(cuid())
  tenantId   String
  endpoint   String
  keys       Json
  categories String[]
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, endpoint])
  @@index([tenantId])
  @@map("push_subscriptions")
}

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  tenantId         String
  email            String
  name             String?
  categories       String[]
  isActive         Boolean   @default(true)
  unsubscribeToken String    @unique @default(cuid())
  lastSentAt       DateTime?
  createdAt        DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("newsletter_subscribers")
}
