# ═══════════════════════════════════════════════════════════════
#  Son Bir Söz — Ortam Değişkenleri (kopyalayıp .env olarak kullanın)
#  Yıldızlı (★) olanlar CANLI (Amplify) için ZORUNLUDUR.
# ═══════════════════════════════════════════════════════════════

# ─── Database (AWS RDS PostgreSQL — canlıda RDS kullanılıyor) ★ ───
# Yerel geliştirme için Neon/yerel Postgres da olur. Canlı = AWS RDS.
# SSL gerekiyorsa sonuna ?sslmode=require ekleyin (kod bunu otomatik işler).
DATABASE_URL="postgresql://user:password@host:5432/sonbirsoz?sslmode=require"

# ─── Auth (NextAuth) ★ ───
# NEXTAUTH_SECRET üretmek için: openssl rand -base64 48
NEXTAUTH_SECRET="change-this-to-a-secure-secret-in-production"
NEXTAUTH_URL="https://<amplify-domain>.amplifyapp.com"

# ─── Seed (ilk admin kullanıcı — `prisma db seed` ile) ★ ───
SEED_ADMIN_EMAIL="admin@sonbirsoz.com"
SEED_ADMIN_PASSWORD="change-this-strong-password"
SEED_ADMIN_NAME="Yönetici"

# ─── Site ───
NEXT_PUBLIC_SITE_URL="https://www.sonbirsoz.com"
NEXT_PUBLIC_SITE_NAME="Son Bir Söz"

# ─── AWS Bedrock (AI haber metni + görsel fallback) ───
AWS_REGION="eu-central-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BEDROCK_MODEL_ID="eu.anthropic.claude-sonnet-4-20250514-v1:0"
# Görsel modelleri eu-central-1'de yok; Stability görselleri us-west-2'de üretilir.
BEDROCK_IMAGE_REGION="us-west-2"

# ─── SSM Content API (AI görsel üretimi — birincil sağlayıcı) ───
# Görsel sağlayıcıya özel endpoint'lerle üretilir (openai, stability, flux, vertex).
SSM_CONTENT_API_URL="https://i3ob0ck5m2.execute-api.eu-central-1.amazonaws.com/prod"
SSM_CONTENT_API_KEY=""
SSM_CDN_URL="https://cdn.aiartists.studio"

# ─── OpenAI (opsiyonel görsel fallback: gpt-image-1) ───
OPENAI_API_KEY=""

# ─── Web Push (tarayıcı bildirimleri) ───
# VAPID anahtarları üretmek için: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@sonbirsoz.com"

# ─── Cron Secret (otomasyon endpoint'lerini korur) ★ ───
# Üretmek için: openssl rand -hex 24
CRON_SECRET=""

# ─── Social Media ───
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_SECRET=""
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_TOKEN=""
INSTAGRAM_ACCOUNT_ID=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""

# ─── Analytics ───
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Google Search Console doğrulama meta tag değeri (content="..." kısmı)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ─── SEO / IndexNow (Bing & Yandex anlık indeksleme) ───
# Üretmek için: openssl rand -hex 16 — yayınlanan her haber otomatik ping'lenir.
INDEXNOW_KEY=""

# ─── E-posta (Amazon SES — bülten ve son dakika mailleri) ───
# SES'te doğrulanmış gönderici adresi ve bölge.
SES_REGION="eu-central-1"
EMAIL_FROM="Son Bir Söz <bulten@sonbirsoz.com>"

# ─── Sesli Özet (Amazon Polly + S3) ───
# Üretilen MP3'lerin yüklendiği bucket (audio/* prefix'i public okunur).
MEDIA_BUCKET="sonbirsoz-media-060768936870"
# Bucket bölgesi (varsayılan eu-central-1)
# MEDIA_REGION="eu-central-1"

# ─── Haber Görselleri (S3) ───
# Eski CDN'den taşınan 24K+ haber görselinin bucket'ı (media/* public okunur).
# scripts/migrate-images.ts bu bucket'a yazar; app yalnızca URL üzerinden okur.
# IMG_BUCKET="sonbirsoz-img-060768936870"
# IMG_REGION="eu-central-1"

# ─── Video Pipeline (Shorts/TikTok/Reels) ───
# Lambda'da ffmpeg binary'si paket limitine sığmadığı için runtime'da bu
# URL'den /tmp'ye indirilir (yerelde ffmpeg-static kullanılır, gerek yok).
FFMPEG_BINARY_URL="https://sonbirsoz-media-060768936870.s3.eu-central-1.amazonaws.com/tools/ffmpeg-linux-x64"

# ─── Servis Entegrasyonları (opsiyonel) ───
# Nöbetçi eczane verisi için CollectAPI anahtarı (https://collectapi.com).
# Tanımlı değilse /servisler/nobetci-eczane boş liste ile graceful davranır.
COLLECTAPI_KEY=""
